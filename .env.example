# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Stripe — ВСТАВЬ РЕАЛЬНЫЕ ключи с https://dashboard.stripe.com/test/apikeys
# НЕ оставляй your_usd_key — это placeholder!
STRIPE_PUBLISHABLE_KEY_USD=pk_test_...
STRIPE_SECRET_KEY_USD=sk_test_...

# Для одного аккаунта продублируй те же ключи:
STRIPE_PUBLISHABLE_KEY_EUR=pk_test_...
STRIPE_SECRET_KEY_EUR=sk_test_...

# Redirect URLs after Stripe Checkout
STRIPE_SUCCESS_URL=http://localhost:8000/admin/
STRIPE_CANCEL_URL=http://localhost:8000/admin/

# For production (optional)
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
